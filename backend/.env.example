# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chargeease

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ─── Image / File Storage ─────────────────────────────────────────────────
# Option A: AWS S3 (takes priority if set)
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# Option B: Cloudinary (used automatically when AWS vars are absent)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=noreply@chargeease.com
FROM_NAME=ChargEase

# Company Email (receives inquiries)
COMPANY_EMAIL=info@chargeease.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin Reset Token Expiry (minutes)
RESET_TOKEN_EXPIRE=10
